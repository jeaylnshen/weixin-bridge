# Server 连接配置
export WEIXIN_SERVER_HOSTNAME=156.233.226.37
export WEIXIN_SERVER_PORT=8787
export WEIXIN_SERVER_SCHEME=http
export WEIXIN_SERVER_SECRET=your_server_secret_here

# Client 节点配置
export WEIXIN_CLIENT_ID=server1
export WEIXIN_CLIENT_LABEL='Cloud Server 1'
export WEIXIN_CLIENT_HOST=0.0.0.0
export WEIXIN_CLIENT_PORT=8788
export WEIXIN_CLIENT_PUBLIC_URL=http://your_client_public_ip:8788

# Agent 本地执行配置（支持 codex, claude, opencode, agy, codebuddy）
export WEIXIN_AGENT_TYPE=codex
# Antigravity 示例:
# export WEIXIN_AGENT_TYPE=agy
# export WEIXIN_AGENT_BIN=/root/.local/bin/agy
# CodeBuddy 示例:
# export WEIXIN_AGENT_TYPE=codebuddy
# export WEIXIN_AGENT_BIN=/root/.nvm/versions/node/v22.13.1/bin/codebuddy
export WEIXIN_CODEX_CWD=/root/.codex
export WEIXIN_CODEX_SANDBOX=workspace-write
export WEIXIN_CODEX_APPROVAL=never
export WEIXIN_CODEX_TIMEOUT_MS=90000
