[Unit]
Description=Weixin Agent Bridge Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/weixin-agent-bridge-server
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=WEIXIN_SERVER_HOST=0.0.0.0
Environment=WEIXIN_SERVER_PORT=8787
Environment=WEIXIN_AGENT_TYPE=codex
Environment=WEIXIN_CODEX_CWD=/srv/project
Environment=WEIXIN_CODEX_SANDBOX=workspace-write
Environment=WEIXIN_CODEX_APPROVAL=never
ExecStart=/usr/bin/node /opt/weixin-agent-bridge-server/weixin-agent-bridge.mjs server
Restart=always
RestartSec=5
StandardOutput=append:/var/log/weixin-agent-bridge-server.log
StandardError=append:/var/log/weixin-agent-bridge-server.log

[Install]
WantedBy=multi-user.target
